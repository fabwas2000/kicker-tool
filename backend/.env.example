# SQLAlchemy DB URL. Lokal reicht SQLite, in Produktion z.B. Postgres bei
# Render/Neon: postgresql+psycopg2://user:pass@host/dbname
DATABASE_URL=sqlite:///./kicker_tool.db

# Kommagetrennte Liste erlaubter CORS-Origins fuer das Frontend.
# "*" erlaubt alles (ok fuer dieses Ein-Personen-Hobbyprojekt ohne Auth).
CORS_ORIGINS=*
